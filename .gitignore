# ============================================================
# KIROYA — .gitignore (корень монорепозитория)
# ============================================================

# Секреты — НИКОГДА в git
.env
.env.*
.env.local
.env.production
*.env
!.env.example
!**/.env.example
bot/.env
backend/.env
web/.env*
!web/.env.example
.token
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.claude/settings.local.json

# База и загрузки (dev-фолбэк без MinIO, docker volumes)
backend/uploads/
backend/uploads_private/
backend/private/
postgres_data/
redis_data/
minio_data/
*.db
*.sqlite

# Дизайн (тяжёлые исходники)
design/*.psd
design/*.ai
design/og-image-source.png
web/design/og-image-source.png
