# ============================================================
# KIROYA — переменные окружения для docker compose (корень репозитория)
# cp .env.example .env   (или: make setup — ещё и сгенерирует секреты)
# .env НЕ коммитить! Значения ниже — только для локальной разработки.
#
# Хосты — имена сервисов docker-сети (db, redis, minio, backend), а не localhost:
# каждый сервис живёт в своём контейнере.
# Запуск без Docker — свои .env в backend/, bot/, web/ (см. README).
# ============================================================

# --- Постгрес ---
POSTGRES_DB=kiroya
POSTGRES_USER=kiroya
POSTGRES_PASSWORD=change_me_in_production
# Пароль в DATABASE_URL должен совпадать с POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://kiroya:change_me_in_production@db:5432/kiroya

# --- Redis (0 — кэш/OTP, 1 — rate limit, 2–3 — Celery, 4 — бот) ---
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# --- MinIO (эти же ключи — логин/пароль консоли http://localhost:9001, пароль ≥ 8 символов) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kiroya
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=kiroya-listings
MINIO_USE_SSL=false
# Адрес, по которому браузер получает фото (с хоста — localhost)
MINIO_PUBLIC_URL=http://localhost:9000

# --- Backend ---
# Подпись JWT. Без него backend не стартует.
# Сгенерируй через: openssl rand -hex 32   (или make setup / scripts\setup.ps1 — сделают сами)
SECRET_KEY=
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
UVICORN_WORKERS=2

# --- Bot (опционально: docker compose --profile with-bot up) ---
BOT_TOKEN=your_bot_token_here
BACKEND_URL=http://backend:8000
# Общий секрет backend ↔ бот (привязка Telegram, rate limit по пользователю Telegram)
BOT_API_SECRET=change_me_shared_with_bot
# Тот же токен — backend шлёт уведомления в Telegram (пусто — уведомления выключены)
TELEGRAM_BOT_TOKEN=

# --- SMS (опционально в dev: при ENVIRONMENT=development код входа пишется в лог backend) ---
SMS_API_KEY=

# --- Alif Pay (опционально в dev) ---
ALIF_PAY_API_KEY=

# --- Web ---
# NEXT_PUBLIC_* встраиваются в JS для браузера — только адреса, никаких секретов
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Адрес MinIO для браузера: фото с него сайт отдаёт через свой /media (см. web/next.config.mjs)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000
# Общий секрет сервер сайта ↔ backend: лимит входа по SMS считается по IP посетителя,
# а не по IP сервера сайта. Сгенерируй через: openssl rand -hex 32
WEB_API_SECRET=
# За reverse proxy (прод): заголовок, который прокси перезаписывает реальным IP посетителя.
# nginx: proxy_set_header X-Real-IP $remote_addr;  → TRUSTED_IP_HEADER=x-real-ip
# Пусто (локально, без прокси) — лимит SMS считается по IP сервера сайта: подделать IP нельзя
TRUSTED_IP_HEADER=
# Флаг Secure у cookie входа. Локально по http — false; в проде за HTTPS — ОБЯЗАТЕЛЬНО true
COOKIE_SECURE=false

# --- Порты на хосте (если заняты — поменяй) ---
BACKEND_PORT=8000
WEB_PORT=3000
