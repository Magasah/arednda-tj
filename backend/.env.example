# ============================================================
# KIROYA backend — шаблон переменных окружения
# Скопируй в .env и заполни значения. .env НЕ коммитить!
# ============================================================

# --- Приложение ---
APP_NAME="KIROYA API"
ENVIRONMENT=development      # local | development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# JSON-массив разрешённых origin'ов для CORS
CORS_ORIGINS=["http://localhost:3000","https://kiroya.tj"]

# --- PostgreSQL + PostGIS ---
# Вариант 1: полный DSN (имеет приоритет над POSTGRES_*)
# DATABASE_URL=postgresql+asyncpg://kiroya:change_me@localhost:5432/kiroya
# Вариант 2: по частям (эти же переменные читает контейнер db)
POSTGRES_HOST=localhost      # в docker-compose переопределяется на "db"
POSTGRES_PORT=5432
POSTGRES_USER=kiroya
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=kiroya

# Пул соединений (на один воркер uvicorn)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0   # в docker-compose: redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100

# --- JWT (можно также SECRET_KEY / ALGORITHM / ACCESS_TOKEN_EXPIRE_MINUTES / REFRESH_TOKEN_EXPIRE_DAYS) ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_generate_random_64_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Платежи: Alif Pay ---
ALIF_PAY_API_KEY=
ALIF_PAY_BASE_URL=https://api.alif.tj

# --- SMS-шлюз (OTP) ---
SMS_API_KEY=
SMS_SENDER=KIROYA

# --- Docker (порты на хосте) ---
BACKEND_PORT=8000
UVICORN_WORKERS=2

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_ATTEMPTS_WINDOW_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_API_URL=https://api.esms.uz/main/send/

# --- Rate limit (slowapi): memory:// для одного процесса, redis:// — для нескольких воркеров ---
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# --- MinIO (фото объявлений). Эти же переменные читает контейнер minio ---
MINIO_ENDPOINT=localhost:9000            # в docker-compose: minio:9000
MINIO_ACCESS_KEY=kiroya
MINIO_SECRET_KEY=change_me_min_8_chars
MINIO_BUCKET=kiroya-listings
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=kiroya
MINIO_ROOT_PASSWORD=change_me_min_8_chars

# --- Бронирование ---
BOOKING_PAYMENT_TTL_MINUTES=15
BOOKING_MAX_DAYS=30
LATE_PENALTY_MULTIPLIER=2
RETURN_AUTO_CONFIRM_HOURS=48
PAYMENT_PAGE_URL=https://kiroya.tj/pay

# --- Celery (в docker-compose: redis://redis:6379/2 и /3) ---
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TIMEZONE=Asia/Dushanbe

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=

# --- Отзывы и аналитика ---
REVIEW_DEADLINE_DAYS=14
REVIEW_DELETE_HOURS=24
PLATFORM_COMMISSION_PERCENT=10

# --- Секрет для Telegram-бота (тот же BOT_API_SECRET в bot/.env) ---
BOT_API_SECRET=change_me_shared_with_bot

# --- Секрет для сервера сайта (тот же WEB_API_SECRET у web): rate limit входа по IP посетителя ---
WEB_API_SECRET=change_me_shared_with_web
