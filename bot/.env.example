# ============================================================
# KIROYA Telegram-бот — шаблон переменных окружения
# Скопируй в .env. .env НЕ коммитить!
# ============================================================

# Токен от @BotFather
BOT_TOKEN=your_bot_token_here
# Адрес backend (в docker-compose: http://backend:8000)
BACKEND_URL=http://localhost:8000
# Тот же секрет, что BOT_API_SECRET в backend/.env
BOT_API_SECRET=change_me_shared_with_backend
# Redis для FSM и токенов. База 4: в backend заняты 0–3 (в docker-compose: redis://redis:6379/4)
REDIS_URL=redis://localhost:6379/4
ENVIRONMENT=development
WEB_URL=https://kiroya.tj
