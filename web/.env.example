# ============================================================
# KIROYA web — шаблон переменных окружения
# Скопируй в .env.local. .env.local НЕ коммитить!
# Всё с префиксом NEXT_PUBLIC_ попадает в браузер — никаких секретов здесь.
# ============================================================

# Адрес backend API (лендинг пока к API не обращается — переменная для будущих страниц)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Публичный адрес сайта (canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://kiroya.tj
